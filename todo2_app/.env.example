# このファイルをコピーして .env を作り、値を入れてください（.env は Git に入れません）
#   cp .env.example .env

# セッションの署名に使う秘密の文字列。次のコマンドで作れます：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 家族で共有するログインの合言葉
FAMILY_PASSWORD=

# 空のままならローカルの SQLite（todo2_app/todo2.db）を使います。
# Supabase を使うときは Transaction pooler（ポート 6543）の接続文字列を入れます。
DATABASE_URL=
